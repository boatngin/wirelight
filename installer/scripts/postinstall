#!/bin/bash
# Fix ownership/permissions and (re)start the privileged helper.
set -u
LABEL="io.github.boatngin.wirelight.helper"
PLIST="/Library/LaunchDaemons/$LABEL.plist"
HELPER="/Library/PrivilegedHelperTools/wgbar-helper"

chown root:wheel "$HELPER" "$PLIST" /usr/local/bin/wgbarctl 2>/dev/null
chmod 755 "$HELPER" /usr/local/bin/wgbarctl
chmod 644 "$PLIST"

launchctl bootout system/"$LABEL" 2>/dev/null || true
for _ in 1 2 3 4 5 6 7 8; do
    launchctl print system/"$LABEL" >/dev/null 2>&1 || break
    sleep 0.25
done
launchctl bootstrap system "$PLIST"

# The package ships wg and wireguard-go; keep them root-only so the helper trusts them.
chown -R root:wheel /Library/PrivilegedHelperTools/wirelight-tools 2>/dev/null || true
chmod -R go-w /Library/PrivilegedHelperTools/wirelight-tools 2>/dev/null || true
exit 0
